LANGFUSE_WEB_PORT=3000
LANGFUSE_MINIO_PORT=9090

# Replace every development secret before sharing or deploying this stack.
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_AUTH=change-me
LANGFUSE_MINIO_ROOT_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=generate-at-least-32-random-bytes
LANGFUSE_SALT=generate-at-least-32-random-bytes
LANGFUSE_ENCRYPTION_KEY=generate-exactly-64-hex-characters

LANGFUSE_INIT_ORG_ID=supportgraph-local
